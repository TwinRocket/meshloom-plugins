{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TwinRocket/meshloom-plugins/schema/entry.schema.json",
  "title": "Catalogue entry (plugins/<id>.yaml)",
  "description": "One plugin of the reviewed catalogue. Owned by this repository (not a meshloom contract); docs/authoring.md describes every field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "tier", "releases"],
  "properties": {
    "id": {
      "description": "The manifest id, <publisher>.<name>; the publisher is the GitHub owner of repo, lowercased.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "repo": {
      "description": "GitHub repository owner/name that publishes the releases.",
      "type": "string",
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
    },
    "tier": {"const": "reviewed"},
    "releases": {
      "description": "Oldest first. A pull request appends one release; existing ones never change.",
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "tag", "sha256"],
        "properties": {
          "version": {
            "description": "The manifest version (strict SemVer).",
            "type": "string",
            "maxLength": 64,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "tag": {
            "description": "The GitHub release tag whose plugin.zip asset is this version.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "sha256": {
            "description": "Lowercase hex SHA-256 of plugin.zip.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "permissions_changed": {
            "description": "Set to true when this release adds or widens a permission compared with the previous release; the CI fails otherwise.",
            "type": "boolean"
          }
        }
      }
    },
    "revoked": {
      "description": "Versions withdrawn by the catalogue operator.",
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"type": "string", "maxLength": 64}
    }
  }
}
